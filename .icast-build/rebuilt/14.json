{"id":"sh/i98ju183","kind":"textbox","name":"Main conclusion","position":{"left":72,"top":154,"width":1136,"height":121},"text":"Gallery prevalence belongs in\nthe retrieval benchmark.","style":{"fontSize":44,"typeface":"Roboto","color":"#0B2545","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/5cz2pwre","kind":"textbox","name":"Conclusion evidence","position":{"left":72,"top":302,"width":1136,"height":95},"text":"Precision and ranking quality decline across every evaluated\nmodel–pathology pair as the target share falls.","style":{"fontSize":30,"typeface":"Roboto","color":"#29333F","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/kbq1wrq9","kind":"textbox","name":"Adaptation conclusion","position":{"left":72,"top":420,"width":1136,"height":95},"text":"Contrastive adaptation leads in this study, with a significant\nadvantage over SwAV-CLS in 10 of 12 conditions.","style":{"fontSize":30,"typeface":"Roboto","color":"#29333F","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/v6h0jm9c","kind":"textbox","name":"Next work label","position":{"left":72,"top":565,"width":300,"height":50},"text":"Next experiments","style":{"fontSize":29,"typeface":"Roboto","color":"#0B2545","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
